{
  "manifest_version": 3,
  "name": "DeepSeek 网页增强",
  "version": "1.4.0",
  "description": "原生关闭虚拟滚动（全量静态 DOM 不闪烁、不卸载）、流式防抢滚、宽屏自适应排版、思维链折叠与记忆、\\[...\\] 公式兼容渲染及源码复制。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DeepSeek 网页增强",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "vendor/katex.min.js",
        "content.js"
      ],
      "css": [
        "vendor/katex.min.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/fonts/*"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ]
}
