{
  "manifest_version": 3,
  "name": "DeepSeek 网页增强",
  "version": "1.0.4",
  "description": "思维链默认收起、记住展开状态、一键全部折叠/展开；并让 \\[...\\]、\\(...\\) 正常渲染成公式，复制公式时自动拿到完整 LaTeX 源码。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DeepSeek 网页增强",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "vendor/katex.min.js",
        "content.js"
      ],
      "css": [
        "vendor/katex.min.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/fonts/*"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ]
}
